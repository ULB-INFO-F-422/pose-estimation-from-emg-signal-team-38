import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import scipy


file_path = r"D:\ML project\guided\guided_dataset_X.npy"
data = np.load(file_path)


ws = 500       
step = 250    
n_samples = 230000

windows = {
    s: {
        e: [data[s, e, i:i+ws] for i in range(0, n_samples - ws + 1, step)]
        for e in range(7)
